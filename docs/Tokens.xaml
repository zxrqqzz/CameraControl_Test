<!--
    Tokens.xaml —— 设计令牌（唯一改色的地方）
    风格来源：CameraControl 的「SaaS Minimalist Modern」石板蓝配色。
    规则：控件样式只引用这里的令牌，不直接写十六进制色值；换主题只改本文件。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════ 表面 / 背景 ═══════════════ -->
    <!-- 深色区域（顶栏 / 侧边栏） -->
    <SolidColorBrush x:Key="DarkSurfaceBrush"      Color="#1E293B" />
    <SolidColorBrush x:Key="DarkSurfaceHoverBrush" Color="#334155" />
    <SolidColorBrush x:Key="AccentBrush"           Color="#475569" />
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#5A6D82" />

    <!-- 浅色区域（内容区） -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CardBrush"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedBrush"      Color="#F1F5F9" />
    <SolidColorBrush x:Key="HoverBrush"      Color="#EEF2F7" />
    <SolidColorBrush x:Key="SubtleBrush"     Color="#FAFBFC" />

    <!-- ═══════════════ 文字 ═══════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextOnDarkBrush"    Color="#E2E8F0" />
    <SolidColorBrush x:Key="TextDimBrush"       Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedTextBrush"     Color="#64748B" /><!-- 兼容旧键名 -->

    <!-- ═══════════════ 边框 / 分隔 ═══════════════ -->
    <SolidColorBrush x:Key="BorderBrush"      Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="DisabledBrush"    Color="#CBD5E1" />

    <!-- ═══════════════ 语义状态色（按钮/标签变体） ═══════════════ -->
    <SolidColorBrush x:Key="InfoBrush"        Color="#2563EB" />
    <SolidColorBrush x:Key="InfoHoverBrush"   Color="#1D4ED8" />
    <SolidColorBrush x:Key="SuccessBrush"     Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarningBrush"     Color="#D97706" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#B45309" />
    <SolidColorBrush x:Key="DangerBrush"      Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />

    <!-- ═══════════════ 自锁按键（抬起=未生效 / 按下=已生效，灰色系） ═══════════════ -->
    <SolidColorBrush x:Key="LatchPressedBrush"       Color="#E2E8F0" />
    <SolidColorBrush x:Key="LatchPressedBorderBrush" Color="#94A3B8" />

    <!-- ═══════════════ 圆角令牌 ═══════════════ -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ═══════════════ 文本样式 ═══════════════ -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 页面标题（保留旧键名 SectionHeader） -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 说明/次要文字（保留旧键名 MutedTextBrush 见上方） -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
