<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CameraControl.Infrastructure</RootNamespace>
    <AssemblyName>CameraControl.Infrastructure</AssemblyName>
    <!-- UVC 采集需要 WinRT 的 IMemoryBufferByteAccess 指针访问 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraControl.Domain\CameraControl.Domain.csproj" />
    <ProjectReference Include="..\CameraControl.Application\CameraControl.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 海康 MVS SDK（AMD64 原生库，项目已由 Directory.Build.props 锁定 x64） -->
    <Reference Include="MvCameraControl.Net">
      <HintPath>..\..\third_party\hik-mvs\MvCameraControl.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 安川 Motoman 通讯库（托管封装 + amd64 原生库） -->
    <Reference Include="YMConnect_CS">
      <HintPath>..\..\third_party\ymconnect\YMConnect_CS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="..\..\third_party\ymconnect\YMConnect.dll">
      <Link>YMConnect.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CameraControl.Infrastructure.Tests" />
  </ItemGroup>

</Project>
