<Window x:Class="CameraControl.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CameraControl — 机器视觉工位控制"
        Height="780"
        Width="1200"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        DataContextChanged="OnDataContextChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 顶栏 -->
            <RowDefinition Height="*" />      <!-- 侧栏 + 内容 -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ═══════════ 顶栏：品牌 + 全局入口 ═══════════ -->
        <Border Grid.Row="0" Style="{StaticResource AppHeaderBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CameraControl" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Width="1" Height="12" Background="{StaticResource BorderBrush}" Margin="12,0" />
                    <TextBlock Text="机器视觉工位控制" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 调色卡：点开选主色，选完立即生效并记住 -->
                    <ToggleButton x:Name="PaletteToggle"
                                  Content="调色"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  Padding="12,4" FontSize="12"
                                  Margin="0,0,8,0"
                                  ToolTip="切换界面主色（交互色）" />

                    <Button Content="AI 设置"
                            Padding="12,5" FontSize="12"
                            Command="{Binding OpenAiSettingsCommand}"
                            ToolTip="模型、密钥与上下文设置" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 调色卡浮层：色卡 = 当前主色的网点刷，点一下整站换色 -->
        <Popup Grid.Row="0" x:Name="PalettePopup"
               IsOpen="{Binding IsChecked, ElementName=PaletteToggle, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=PaletteToggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               VerticalOffset="6">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="2"
                    Padding="14,12"
                    DataContext="{Binding Appearance}">
                <StackPanel Width="270">
                    <TextBlock Text="界面主色" Style="{StaticResource CardHeader}" />
                    <TextBlock Margin="0,4,0,12" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap"
                               Text="只换「能点 / 已选」的颜色，背景仍是白纸黑线。" />

                    <ItemsControl ItemsSource="{Binding Swatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,8,10" Width="56">
                                    <Button Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.ApplyCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Name}">
                                        <Border Width="52" Height="34" Background="{Binding Halftone}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderThickness" Value="4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Button>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                            Margin="0,2,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDimBrush}" Text="当前：" />
                            <TextBlock FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                       Text="{Binding CurrentName}" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="恢复默认"
                                Style="{StaticResource GhostButton}"
                                Padding="8,3" FontSize="11"
                                Command="{Binding ResetCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════ 内容区（先声明：侧栏要用 ElementName 双向绑它的 SelectedIndex） ═══════════ -->
            <TabControl Grid.Column="1" x:Name="MainTabs" Style="{StaticResource TablessTabControl}">

                <!-- ─────────── 设备 ─────────── -->
                <TabItem Header="设备">
                    <Grid Style="{StaticResource PageRoot}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Style="{StaticResource PageHeaderRow}">
                                <Border Style="{StaticResource PageTitleMark}" />
                                <TextBlock Text="设备" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="刷新枚举 → 选中相机 → 连接 → 采集。图像只在内存里，不落盘。" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：设备列表 -->
                            <Border Grid.Column="0" Style="{StaticResource FlushCardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource CardHeaderBar}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource SectionTitleMark}" />
                                                <TextBlock Text="相机" Style="{StaticResource CardHeader}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource BadgeBorderStyle}" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource BadgeTextStyle}"
                                                               Text="{Binding Cameras.Count, StringFormat={}{0} 台}" />
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="刷新" Padding="10,3" FontSize="12"
                                                    Command="{Binding RefreshCamerasCommand}"
                                                    ToolTip="重新枚举本机相机" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="DeviceList"
                                                 ItemsSource="{Binding Cameras}"
                                                 SelectedItem="{Binding SelectedCamera}"
                                                 Style="{StaticResource ListBoxStyle}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyle}">
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource RowBorderStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Id}" />
                                                                <!-- 次要文字不写死灰色：继承行的前景色 + 透明度，选中（主色底）时自动变浅 -->
                                                                <TextBlock Text="{Binding KindText}"
                                                                           FontSize="11"
                                                                           Opacity="0.72"
                                                                           Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{StaticResource WarningBrush}"
                                                                           Margin="0,2,0,0"
                                                                           Text="{Binding Hint}"
                                                                           Visibility="{Binding Hint, Converter={StaticResource EmptyToCollapsed}}" />
                                                            </StackPanel>

                                                            <Border Grid.Column="1"
                                                                    Style="{StaticResource BadgeSuccessBorderStyle}"
                                                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Style="{StaticResource BadgeSuccessTextStyle}" Text="已连接" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Margin="24"
                                                   Text="还没有枚举到相机&#10;点右上角「刷新」获取本机设备">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=DeviceList, Path=HasItems}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 右：预览 + 动作 -->
                            <Border Grid.Column="2" Style="{StaticResource FlushCardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource CardHeaderBar}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource SectionTitleMark}" />
                                                <TextBlock Text="图像预览"
                                                           Style="{StaticResource CardHeader}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="连接" Padding="12,3" FontSize="12"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding ConnectCommand}" />
                                                <Button Content="断开" Padding="12,3" FontSize="12"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DisconnectCommand}" />
                                                <Button Content="拍一张" Padding="14,3" FontSize="12"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding CaptureCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Background="{StaticResource MutedBrush}"
                                            BorderThickness="0">
                                        <Grid>
                                            <TextBlock Style="{StaticResource EmptyStateText}"
                                                       Text="点击「拍一张」显示采集结果"
                                                       Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisible}}" />

                                            <Image Source="{Binding PreviewImage}"
                                                   Stretch="Uniform"
                                                   Margin="12"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <!-- 没有图像信息时不摆一条空的分隔带 -->
                                    <Border Grid.Row="2"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,1,0,0"
                                            Visibility="{Binding ImageInfo, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding ImageInfo}"
                                                   Style="{StaticResource MonoTextStyle}"
                                                   Margin="16,10"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ─────────── 标定 ─────────── -->
                <TabItem Header="标定">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Style="{StaticResource PageHeaderRow}">
                                <Border Style="{StaticResource PageTitleMark}" />
                                <TextBlock Text="标定" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="拍不少于 10 个视角 → 内置角点检测 → 张氏标定求解并保存。" />
                            </StackPanel>

                            <!-- ① 棋盘参数 -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionTitleRow}">
                                    <Border Style="{StaticResource SectionTitleMark}" />
                                    <TextBlock Text="相机与棋盘" Style="{StaticResource CardHeader}" />
                                </StackPanel>

                                    <StackPanel Style="{StaticResource FieldRow}">
                                        <TextBlock Text="相机" Style="{StaticResource FieldLabelTextStyle}" Width="76" />
                                        <ComboBox ItemsSource="{Binding Calibration.Cameras}"
                                                  SelectedItem="{Binding Calibration.SelectedCamera}"
                                                  DisplayMemberPath="DisplayName"
                                                  Width="320" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource FieldRow}">
                                        <TextBlock Text="内角点数" Style="{StaticResource FieldLabelTextStyle}" Width="76" />
                                        <TextBox Text="{Binding Calibration.GridCols, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="64" />
                                        <TextBlock Text="列 ×" Style="{StaticResource FieldLabelTextStyle}" Margin="8,0" />
                                        <TextBox Text="{Binding Calibration.GridRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="64" />
                                        <TextBlock Text="行" Style="{StaticResource FieldLabelTextStyle}" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource FieldRow}">
                                        <TextBlock Text="方格边长" Style="{StaticResource FieldLabelTextStyle}" Width="76" />
                                        <TextBox Text="{Binding Calibration.SquareMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="80" />
                                        <TextBlock Text="mm" Style="{StaticResource FieldLabelTextStyle}" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <Button Content="应用棋盘参数"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Command="{Binding Calibration.ConfigureCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- ② 采集动作 -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="拍摄并检测" Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0"
                                                Command="{Binding Calibration.CaptureCommand}" />
                                        <Button Content="求解并保存" Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"
                                                Command="{Binding Calibration.SolveCommand}" />
                                        <Button Content="清空视角" Style="{StaticResource GhostButton}"
                                                Command="{Binding Calibration.ResetCommand}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                                        <TextBlock Style="{StaticResource BadgeTextStyle}"
                                                   Text="{Binding Calibration.ViewCountText, Mode=OneWay}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ③ 状态与结果 -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionTitleRow}" Margin="0,0,0,8">
                                    <Border Style="{StaticResource SectionTitleMark}" />
                                    <TextBlock Text="状态" Style="{StaticResource CardHeader}" />
                                </StackPanel>
                                    <TextBlock Text="{Binding Calibration.Status}" TextWrapping="Wrap"
                                               Style="{StaticResource BodyTextStyle}" />

                                    <!-- 结果为空时不摆一个空的标题：标定还没跑过就不该有这一块 -->
                                    <StackPanel Visibility="{Binding Calibration.Result, Converter={StaticResource EmptyToCollapsed}}">
                                        <Separator Style="{StaticResource CardDivider}" />
                                        <TextBlock Text="求解结果" Style="{StaticResource CardHeader}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Calibration.Result}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ④ 说明 -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionTitleRow}" Margin="0,0,0,8">
                                    <Border Style="{StaticResource SectionTitleMark}" />
                                    <TextBlock Text="怎么用" Style="{StaticResource CardHeader}" />
                                </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                                               Text="1）先到「设备」页刷新并打开相机；2）确认棋盘内角点行列与方格边长；3）从不同角度、不同距离拍 10 张以上（深度要拉开）；4）求解并保存。" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                               Text="内置角点检测对光照和清晰度敏感。若提示点数不符或覆盖率低，请改善光照或换更清晰的棋盘——不要硬用低覆盖率的结果标定。" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ─────────── 系统 ─────────── -->
                <TabItem Header="系统">
                    <Grid Style="{StaticResource PageRoot}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Style="{StaticResource PageHeaderRow}">
                                <Border Style="{StaticResource PageTitleMark}" />
                                <TextBlock Text="系统" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="自检看环境是否可用；指标与审计看这台机器最近干了什么。" />
                        </StackPanel>

                        <!-- 自检 -->
                        <Border Grid.Row="1" Style="{StaticResource FlushCardBorderStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource CardHeaderBar}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource SectionTitleMark}" />
                                            <TextBlock Text="自检" Style="{StaticResource CardHeader}" VerticalAlignment="Center" />
                                            <TextBlock Text="检查权限 / 系统 / 存储 / SDK / 相机"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="启动自检"
                                                Padding="12,3" FontSize="12"
                                                Command="{Binding RunSelfCheckCommand}" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,8,0,8">
                                    <ListBox x:Name="SelfCheckList" ItemsSource="{Binding SelfCheckItems}"
                                             Style="{StaticResource LogListBoxStyle}"
                                             MaxHeight="190"
                                             BorderThickness="0"
                                             Padding="12,0" />

                                    <TextBlock Text="点「启动自检」检查这台机器能不能干活"
                                               Margin="0,16,0,16"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=SelfCheckList, Path=HasItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 指标 / 审计 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource FlushCardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource CardHeaderBar}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource SectionTitleMark}" />
                                            <TextBlock Text="指标" Style="{StaticResource CardHeader}" VerticalAlignment="Center" />
                                        </StackPanel>
                                            <Button Grid.Column="1" Content="刷新" Padding="10,3" FontSize="12"
                                                    Command="{Binding RefreshMetricsCommand}" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="MetricList" ItemsSource="{Binding MetricItems}"
                                                 Style="{StaticResource LogListBoxStyle}"
                                                 BorderThickness="0"
                                                 Padding="12,8" />

                                        <TextBlock Text="点「刷新」查看运行时指标"
                                                   Margin="24"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=MetricList, Path=HasItems}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource FlushCardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource CardHeaderBar}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource SectionTitleMark}" />
                                            <TextBlock Text="审计日志" Style="{StaticResource CardHeader}" VerticalAlignment="Center" />
                                        </StackPanel>
                                            <Button Grid.Column="1" Content="刷新" Padding="10,3" FontSize="12"
                                                    Command="{Binding RefreshAuditCommand}" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="AuditList" ItemsSource="{Binding AuditItems}"
                                                 Style="{StaticResource LogListBoxStyle}"
                                                 BorderThickness="0"
                                                 Padding="12,8" />

                                        <TextBlock Text="点「刷新」查看最近的操作留痕"
                                                   Margin="24"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=AuditList, Path=HasItems}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ─────────── AI：只有 in / out 两块（最小可用版，逐项加回来） ─────────── -->
                <TabItem Header="AI">
                    <Grid Style="{StaticResource PageRoot}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="ChatScroll" Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding AiMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" MaxWidth="700" Padding="12,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                           Text="{Binding TimeText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" Style="{StaticResource FlushCardBorderStyle}" Margin="0,10,0,0">
                            <Grid Margin="14,10,14,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" x:Name="GoalBox"
                                         Text="{Binding AiGoal, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BareTextBox}"
                                         MinLines="1" MaxLines="6"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         PreviewKeyDown="OnGoalKeyDown" />

                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}"
                                               Text="Enter 发送 · Shift+Enter 换行" VerticalAlignment="Bottom" />

                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                            Padding="8,2" FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Content="{Binding AiModelLine}" Margin="0,0,10,0"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding OpenAiSettingsCommand}"
                                            ToolTip="打开 AI 设置，换模型 / 调强度" />

                                    <Grid Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button Content="发送" Width="76" Height="30"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding RunAiCommand}"
                                                Visibility="{Binding IsAiRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Button Content="停止" Width="76" Height="30"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding StopAiCommand}"
                                                Visibility="{Binding IsAiRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ═══════════ 侧栏导航 ═══════════ -->
            <Border Grid.Column="0" Style="{StaticResource SidebarBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="导航"
                               FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"
                               Margin="20,16,0,6" />

                    <ListBox x:Name="NavList"
                             Style="{StaticResource NavListBoxStyle}"
                             SelectedIndex="{Binding ElementName=MainTabs, Path=SelectedIndex, Mode=TwoWay}"
                             VerticalAlignment="Top">
                        <ListBoxItem Style="{StaticResource NavListBoxItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M2,5 L16,5 L16,15 L2,15 Z M4.4,10 A1.6,1.6 0 1 1 7.6,10 A1.6,1.6 0 1 1 4.4,10" />
                                <TextBlock Text="设备" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavListBoxItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M2,2 L16,2 L16,16 L2,16 Z M2,7 L16,7 M2,11.5 L16,11.5 M7,2 L7,16 M11.5,2 L11.5,16" />
                                <TextBlock Text="标定" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavListBoxItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M2,5 L16,5 M2,9 L16,9 M2,13 L16,13" />
                                <TextBlock Text="系统" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavListBoxItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M9,2 L10.4,6.6 L15,8 L10.4,9.4 L9,14 L7.6,9.4 L3,8 L7.6,6.6 Z" />
                                <TextBlock Text="AI" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ 状态栏 ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Status}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip="{Binding Status}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="处理中…" FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
