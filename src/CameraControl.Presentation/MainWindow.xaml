<Window x:Class="CameraControl.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CameraControl — 机器视觉工位控制"
        Height="760"
        Width="1180"
        MinHeight="600"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFFFF" DataContextChanged="OnDataContextChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="8,8,8,0" Padding="0">

            <!-- ═══════════ 设备 ═══════════ -->
            <TabItem Header="设备">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：列表 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="刷新"
                                    Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding RefreshCamerasCommand}" />
                            <Button Content="连接"
                                    Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding ConnectCommand}" />
                            <Button Content="断开"
                                    Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding DisconnectCommand}" />
                            <Button Content="拍一张"
                                    Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding CaptureCommand}"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    BorderBrush="{StaticResource AccentBrush}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <ListBox ItemsSource="{Binding Cameras}"
                                     SelectedItem="{Binding SelectedCamera}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Subtitle, Mode=OneWay}" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource WarnBrush}"
                                                               Text="{Binding Hint}"
                                                               Visibility="{Binding Hint, Converter={StaticResource EmptyToCollapsed}}" />
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3"
                                                        Padding="7,2"
                                                        Background="#FFEAF2FE">
                                                    <TextBlock FontSize="11"
                                                               Text="已连接"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- 右：图像 -->
                    <Border Grid.Column="2"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="{StaticResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="点击「拍一张」显示采集结果&#10;（图像只在内存中，不落盘）"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisible}}" />

                            <Image Grid.Row="0"
                                   Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   Margin="12"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,8">
                                <TextBlock Text="{Binding ImageInfo}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════ 系统 ═══════════ -->
            <TabItem Header="标定">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="12"
                            BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="相机与棋盘" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="相机" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Calibration.Cameras}"
                                          SelectedItem="{Binding Calibration.SelectedCamera}"
                                          DisplayMemberPath="DisplayName"
                                          Width="320" Height="30" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="内角点列" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Calibration.GridCols, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="56" Height="30" />
                                <TextBlock Text="行" VerticalAlignment="Center" Margin="10,0,6,0" />
                                <TextBox Text="{Binding Calibration.GridRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="56" Height="30" />
                                <TextBlock Text="方格 mm" VerticalAlignment="Center" Margin="10,0,6,0" />
                                <TextBox Text="{Binding Calibration.SquareMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="72" Height="30" />
                                <Button Content="应用棋盘"
                                        Command="{Binding Calibration.ConfigureCommand}"
                                        Margin="10,0,0,0" Height="30" MinWidth="90" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="拍摄并检测" Command="{Binding Calibration.CaptureCommand}"
                                Height="32" MinWidth="110" />
                        <Button Content="求解并保存" Command="{Binding Calibration.SolveCommand}"
                                Margin="8,0,0,0" Height="32" MinWidth="110" />
                        <Button Content="清空视角" Command="{Binding Calibration.ResetCommand}"
                                Margin="8,0,0,0" Height="32" MinWidth="90" />
                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding Calibration.ViewCountText, Mode=OneWay}" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="0,0,0,10" Padding="12"
                            BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Calibration.Status}" TextWrapping="Wrap"
                                       Foreground="#555555" />
                            <TextBlock Text="{Binding Calibration.Result}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Padding="12"
                            BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="怎么用" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" Foreground="#555555"
                                           Text="1）先到「设备」页刷新并打开相机；2）确认棋盘内角点行列与方格边长；3）从不同角度、不同距离拍 10 张以上（深度要拉开）；4）求解并保存。" />
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#B36B00"
                                           Text="内置角点检测对光照和清晰度敏感。若提示点数不符或覆盖率低，请改善光照或换更清晰的棋盘——不要硬用低覆盖率的结果标定。" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="系统">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="启动自检"
                                    Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding RunSelfCheckCommand}" />
                            <TextBlock Text="检查权限/系统/存储/SDK/相机"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SelfCheckItems}"
                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                 FontFamily="Consolas"
                                 FontSize="12" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="指标"
                                    Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding RefreshMetricsCommand}" />
                            <Button Content="审计日志"
                                    Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding RefreshAuditCommand}" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0"
                                     ItemsSource="{Binding MetricItems}"
                                     BorderBrush="{StaticResource BorderBrushSoft}"
                                     FontFamily="Consolas"
                                     FontSize="11" />

                            <ListBox Grid.Column="2"
                                     ItemsSource="{Binding AuditItems}"
                                     BorderBrush="{StaticResource BorderBrushSoft}"
                                     FontFamily="Consolas"
                                     FontSize="11" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════ AI ═══════════ -->
            <TabItem Header="AI">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 模型配置：填密钥自动识别；使用时切模型/强度 -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel>

                            <!-- ① 新增：只填密钥 -->
                            <TextBlock Text="新增配置" FontWeight="SemiBold" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="380" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="密钥：" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <PasswordBox Grid.Column="1"
                                             x:Name="ApiKeyBox"
                                             Height="30" VerticalContentAlignment="Center"
                                             PasswordChanged="OnApiKeyChanged" />
                                <Button Grid.Column="2"
                                        Content="识别并新增"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding DetectAndAddProfileCommand}"
                                        Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Text="填入密钥即可，会自动判断是哪家服务（先按前缀猜，不中再逐家探测）。保存后密钥不可查看、不可修改。"
                                       FontSize="11" Margin="52,4,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" />

                            <TextBlock Text="{Binding AiDetectStatus}"
                                       FontSize="11" Margin="52,4,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" />

                            <!-- 识别失败才出现的手填区 -->
                            <StackPanel Margin="52,10,0,0"
                                        Visibility="{Binding AiShowManualBaseUrl, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="没能自动识别，手动指定服务地址：" FontSize="11"
                                           Foreground="{StaticResource WarnBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBox Width="300" Height="30" VerticalContentAlignment="Center"
                                             ToolTip="如 https://api.example.com/v1"
                                             Text="{Binding AiManualBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Width="200" Height="30" IsEditable="True" Margin="6,0,0,0"
                                              ToolTip="模型名：可先拉取，也可直接填"
                                              ItemsSource="{Binding AiManualModelOptions}"
                                              Text="{Binding AiManualModel, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="用手填信息新增"
                                            Style="{StaticResource ToolButtonStyle}"
                                            Command="{Binding AddManualProfileCommand}"
                                            Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding AiManualStatus}" FontSize="11" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>

                            <Separator Margin="0,14,0,12" />

                            <!-- ② 使用：切配置 / 切模型 / 切强度 -->
                            <TextBlock Text="使用中" FontWeight="SemiBold" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="配置：" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" Height="30"
                                          ItemsSource="{Binding AiProfiles}"
                                          SelectedItem="{Binding AiSelectedProfile}"
                                          DisplayMemberPath="Display" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="使用"
                                            Style="{StaticResource ToolButtonStyle}"
                                            Command="{Binding UseAiProfileCommand}" />
                                    <Button Content="测试连通"
                                            Style="{StaticResource ToolButtonStyle}"
                                            Command="{Binding TestAiConnectionCommand}"
                                            Margin="6,0,0,0" />
                                    <Button Content="删除"
                                            Style="{StaticResource ToolButtonStyle}"
                                            Command="{Binding RemoveAiProfileCommand}"
                                            Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding AiKeyStatus}" FontSize="11" Margin="52,4,0,0"
                                       Foreground="{StaticResource MutedBrush}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="模型：" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" Height="30" IsEditable="True"
                                          ItemsSource="{Binding AiCurrentModelOptions}"
                                          Text="{Binding AiCurrentModel, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="刷新模型"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding ReloadCurrentModelsCommand}"
                                        Margin="6,0,0,0" />

                                <!-- 只有模型支持思考强度时才显示 -->
                                <TextBlock Grid.Column="3" Text="强度：" VerticalAlignment="Center"
                                           Margin="14,0,8,0"
                                           Visibility="{Binding AiStrengthSupported, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox Grid.Column="4" Width="120" Height="30"
                                          SelectedIndex="{Binding AiStrengthIndex}"
                                          Visibility="{Binding AiStrengthSupported, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBoxItem Content="Off（关思考，最快）" />
                                    <ComboBoxItem Content="Low" />
                                    <ComboBoxItem Content="High（默认）" />
                                    <ComboBoxItem Content="Max（最慢最强）" />
                                </ComboBox>

                                <Button Grid.Column="5" Content="应用"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding ApplyCurrentSelectionCommand}"
                                        Margin="10,0,0,0" />
                            </Grid>

                            <TextBlock Text="{Binding AiCatalogSource}" FontSize="11" Margin="52,4,0,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>




                    <!-- 目标输入 -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding AiGoal, UpdateSourceTrigger=PropertyChanged}"
                                 Height="56"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Center"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,10,0" />

                        <Button Grid.Column="1"
                                Content="运行"
                                Width="110"
                                Command="{Binding RunAiCommand}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderBrush="{StaticResource AccentBrush}" />
                    </Grid>

                    <!-- 用量：标题一行，点开看明细（缓存命中 / 未缓存输入 / 输出） -->
                    <Expander Grid.Row="2"
                              Margin="0,8,0,0"
                              IsExpanded="{Binding AiUsageExpanded, Mode=TwoWay}"
                              Foreground="{StaticResource MutedBrush}">
                        <Expander.Header>
                            <TextBlock Text="{Binding AiUsageText}" FontSize="11" />
                        </Expander.Header>
                        <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="10" Margin="0,4,0,0">
                            <TextBlock Text="{Binding AiUsageDetail}"
                                       FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Expander>

                    <!-- 步骤 + 答复 -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="执行步骤">
                            <ListBox ItemsSource="{Binding AiSteps}"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="模型答复">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding AiAnswer}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Margin="6" />
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Text="处理中…"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
