<Window x:Class="CameraControl.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CameraControl.Presentation.Views"
        Title="CameraControl — 机器视觉工位控制"
        Height="780"
        Width="1200"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- 主窗口只负责「摆放」：顶栏 / 导航 + 内容 / 状态栏。
         每一块的实现都在 Views 下各自独立的 UserControl 里。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 顶栏 -->
            <RowDefinition Height="*" />      <!-- 侧栏 + 内容 -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <views:AppHeaderView Grid.Row="0" x:Name="AppHeader" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:NavSidebarView Grid.Column="0" />

            <TabControl Grid.Column="1"
                        x:Name="MainTabs"
                        Style="{StaticResource TablessTabControl}"
                        SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">
                <TabItem Header="设备">
                    <views:DevicesPage />
                </TabItem>
                <TabItem Header="标定">
                    <views:CalibrationPage />
                </TabItem>
                <TabItem Header="系统">
                    <views:SystemPage />
                </TabItem>
                <TabItem Header="AI">
                    <views:AiChatPage />
                </TabItem>
            </TabControl>
        </Grid>

        <views:StatusBarView Grid.Row="2" />
    </Grid>
</Window>
