<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>CameraControl.Presentation</RootNamespace>
    <AssemblyName>CameraControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 的 XAML 生成代码会带来大量与业务无关的警告，这里单独放宽 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraControl.Composition\CameraControl.Composition.csproj" />
  </ItemGroup>

</Project>
