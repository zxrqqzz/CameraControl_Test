<Window x:Class="CameraControl.Presentation.Views.ContextManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上下文管理"
        Width="820" Height="540"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Style="{StaticResource AppHeaderBorder}">
            <StackPanel>
                <TextBlock Text="上下文管理" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="上下文只追加不改写；这里的删除会连磁盘上的 jsonl 一起删掉。" />
            </StackPanel>
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="1" Style="{StaticResource FlushCardBorderStyle}" Margin="20,16,20,0">
            <Grid>
                <ListBox x:Name="List"
                         ItemsSource="{Binding Rows}"
                         Style="{StaticResource ListBoxStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyle}">
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <Border Style="{StaticResource BadgeSuccessBorderStyle}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource BadgeSuccessTextStyle}" Text="当前" />
                                        </Border>

                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="已归档" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Meta}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           Style="{StaticResource EmptyStateText}"
                           Text="该配置下还没有上下文"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 提示 -->
        <TextBlock Grid.Row="2" x:Name="HintText"
                   Style="{StaticResource CaptionTextStyle}"
                   Margin="20,10,20,0" />

        <!-- 动作 -->
        <Border Grid.Row="3" Style="{StaticResource StatusBarBorder}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="删除不可恢复；需要备份就先「打开文件夹」复制一份。"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="删除选中"
                            Style="{StaticResource DangerButton}"
                            Padding="12,6" FontSize="12"
                            Margin="0,0,8,0"
                            Click="OnDeleteClick" />
                    <Button Content="刷新" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                            Click="OnReloadClick" />
                    <Button Content="打开文件夹" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                            Click="OnOpenFolderClick" />
                    <Button Content="关闭" Padding="12,6" FontSize="12"
                            IsCancel="True"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
