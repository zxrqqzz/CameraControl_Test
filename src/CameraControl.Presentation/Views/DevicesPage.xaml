<UserControl x:Class="CameraControl.Presentation.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Style="{StaticResource PageHeaderRow}">
                <Border Style="{StaticResource PageTitleMark}" />
                <TextBlock Text="设备" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="刷新枚举 → 选中相机 → 连接 → 采集。图像只在内存里，不落盘。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：设备列表 -->
            <Border Grid.Column="0" Style="{StaticResource FlushCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource SectionTitleMark}" />
                                <TextBlock Text="相机" Style="{StaticResource CardHeader}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource BadgeBorderStyle}" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource BadgeTextStyle}"
                                               Text="{Binding Cameras.Count, StringFormat={}{0} 台}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新" Padding="10,3" FontSize="12"
                                    Command="{Binding RefreshCamerasCommand}"
                                    ToolTip="重新枚举本机相机" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="DeviceList"
                                 ItemsSource="{Binding Cameras}"
                                 SelectedItem="{Binding SelectedCamera}"
                                 Style="{StaticResource ListBoxStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyle}">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Id}" />
                                                <!-- 次要文字不写死灰色：继承行的前景色 + 透明度，选中（主色底）时自动变浅 -->
                                                <TextBlock Text="{Binding KindText}"
                                                           FontSize="11"
                                                           Opacity="0.72"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Margin="0,2,0,0"
                                                           Text="{Binding Hint}"
                                                           Visibility="{Binding Hint, Converter={StaticResource EmptyToCollapsed}}" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource BadgeSuccessBorderStyle}"
                                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource BadgeSuccessTextStyle}" Text="已连接" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Margin="24"
                                   Text="还没有枚举到相机&#10;点右上角「刷新」获取本机设备">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=DeviceList, Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右：预览 + 动作 -->
            <Border Grid.Column="2" Style="{StaticResource FlushCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardHeaderBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource SectionTitleMark}" />
                                <TextBlock Text="图像预览"
                                           Style="{StaticResource CardHeader}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="连接" Padding="12,3" FontSize="12"
                                        Margin="0,0,6,0"
                                        Command="{Binding ConnectCommand}" />
                                <Button Content="断开" Padding="12,3" FontSize="12"
                                        Margin="0,0,6,0"
                                        Command="{Binding DisconnectCommand}" />
                                <Button Content="拍一张" Padding="14,3" FontSize="12"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CaptureCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource MutedBrush}"
                            BorderThickness="0">
                        <Grid>
                            <TextBlock Style="{StaticResource EmptyStateText}"
                                       Text="点击「拍一张」显示采集结果"
                                       Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisible}}" />

                            <Image Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   Margin="12"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <!-- 没有图像信息时不摆一条空的分隔带 -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding ImageInfo, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{Binding ImageInfo}"
                                   Style="{StaticResource MonoTextStyle}"
                                   Margin="16,10"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
