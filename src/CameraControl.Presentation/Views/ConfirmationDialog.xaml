<Window x:Class="CameraControl.Presentation.Views.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="需要人工确认"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <StackPanel>

        <!-- 标题条：默认不可执行，所以用警示色而不是主色 -->
        <Border Style="{StaticResource AppHeaderBorder}" Padding="20,16,20,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Background="{StaticResource WarningBrush}" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock Text="需要人工确认" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="AI 请求执行一个会改变设备状态的操作"
                               Style="{StaticResource PageSubtitle}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 详情 -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="20,16,20,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="操作" Style="{StaticResource KvLabel}" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource KvValue}" FontWeight="SemiBold" />
                </StackPanel>

                <Separator Style="{StaticResource CardDivider}" Margin="0,10" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="能力 id" Style="{StaticResource KvLabel}" />
                    <TextBlock x:Name="CapabilityText" Style="{StaticResource KvValueMono}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="风险等级" Style="{StaticResource KvLabel}" />
                    <TextBlock x:Name="RiskText" Style="{StaticResource KvValue}" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="发起者" Style="{StaticResource KvLabel}" />
                    <TextBlock x:Name="ActorText" Style="{StaticResource KvValue}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 红色警告：只对物理/破坏性操作显示（由代码后台控制可见性） -->
        <Border x:Name="WarningBanner" Style="{StaticResource DangerBanner}" Margin="20,12,20,0">
            <TextBlock Text="该操作会改变物理设备状态。请确认现场安全（人员、工件、机械臂行程）后再批准。"
                       FontSize="12"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- 按钮：拒绝在左（默认焦点），批准在右且明确标出风险 -->
        <Border Style="{StaticResource StatusBarBorder}" Padding="20,14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}"
                           Text="按 ESC 或点「拒绝」都不会执行任何操作。" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="拒绝"
                            Width="92" Height="32"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="OnRejectClick" />
                    <Button Content="批准执行"
                            Width="112" Height="32"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnApproveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
