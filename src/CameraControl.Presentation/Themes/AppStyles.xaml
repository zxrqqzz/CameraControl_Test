<!--
    AppStyles.xaml —— 界面骨架样式（波普：黄顶栏 + 黄状态栏 + 黄标题块）
    ══════════════════════════════════════════════════════════════════════════
    分工：
      · Tokens.xaml  = 颜色 + 排版令牌（改色只改那里）
      · Controls.xaml = 单个控件长什么样
      · AppStyles.xaml = 页面怎么拼（这一层只做布局、色块与留白，不发明新颜色）
    外壳三段黄：顶栏（品牌）、页面标题标记、状态栏。中间是白卡片 + 黑框。
    ══════════════════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 正文下限 13px；只设字号，不设字体/颜色——否则会盖掉等宽列表的继承 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ═══════════════ 外壳：顶栏 / 侧栏 / 状态栏 ═══════════════ -->
    <!-- 顶栏：白底 + 2px 黑底边（背景保持安静，颜色留给交互元素） -->
    <Style x:Key="AppHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="20,11" />
    </Style>

    <!-- 侧栏：白底 + 2px 黑右边（一分为二的版面） -->
    <Style x:Key="SidebarBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0,0,2,0" />
    </Style>

    <!-- 状态栏：白底 + 1px 黑顶边 -->
    <Style x:Key="StatusBarBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="20,7" />
    </Style>

    <!-- 页面容器：统一留白 -->
    <Style x:Key="PageRoot" TargetType="Grid">
        <Setter Property="Margin" Value="20" />
    </Style>

    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- ═══════════════ 页面标题：黄色方块 + 粗黑标题 ═══════════════ -->
    <Style x:Key="PageHeaderRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageTitleMark" TargetType="Border">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{StaticResource PopYellowHalftoneBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════ 组合：动作行 / 字段行 / 指标 ═══════════════ -->
    <!-- 卡片内小标题行：黄方块 + 粗标题（内容型卡片用，比整条黄标题栏轻） -->
    <Style x:Key="SectionTitleRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SectionTitleMark" TargetType="Border">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Background" Value="{StaticResource PopYellowHalftoneBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 卡片标题条：白底 + 1px 黑底线 + 左侧小黄块（由视图里放 SectionTitleMark）。
         背景不放颜色：颜色是"可点/已选"的信号，不能拿来做装饰。 -->
    <Style x:Key="CardHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <Style x:Key="ToolbarRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="FieldRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- 指标块：上面一个数字，下面一行标签 -->
    <Style x:Key="MetricBlock" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>

    <!-- 键值对：左标签定宽右值 -->
    <Style x:Key="KvLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelTextStyle}">
        <Setter Property="Width" Value="72" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,1,12,0" />
    </Style>

    <Style x:Key="KvValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="KvValueMono" TargetType="TextBlock" BasedOn="{StaticResource KvValue}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ═══════════════ 状态文字（语义色） ═══════════════ -->
    <Style x:Key="TextSuccessStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SuccessHoverBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="TextDangerStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ═══════════════ 空状态 ═══════════════ -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- ═══════════════ 横幅（浅色底 + 2px 黑框，内文用语义色） ═══════════════ -->
    <Style x:Key="DangerBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="WarningBanner" TargetType="Border" BasedOn="{StaticResource DangerBanner}">
        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
    </Style>

    <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource DangerBanner}">
        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
    </Style>

    <!-- ═══════════════ 导航图标（颜色跟随所在导航项的前景色） ═══════════════ -->
    <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Square" />
        <Setter Property="StrokeEndLineCap" Value="Square" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- 小号行内图标（按钮/标题前缀） -->
    <Style x:Key="InlineIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

</ResourceDictionary>
