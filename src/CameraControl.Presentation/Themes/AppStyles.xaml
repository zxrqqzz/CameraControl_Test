<!--
    AppStyles.xaml —— 界面骨架样式（页头 / 卡片组合 / 状态栏 / 空状态 / 横幅）
    ══════════════════════════════════════════════════════════════════════════
    分工：
      · Tokens.xaml  = 颜色 + 排版令牌（改色只改那里）
      · Controls.xaml = 单个控件长什么样
      · AppStyles.xaml = 页面怎么拼（这一层只做布局与留白，不发明新颜色）
    转换器（NullToCollapsed 等）仍在 App.xaml：它们依赖 C# 类型，不适合放字典。
    ══════════════════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 正文下限 13px；只设字号，不设字体/颜色——否则会盖掉等宽列表的继承 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ═══════════════ 外壳：顶栏 / 侧栏 / 状态栏 ═══════════════ -->
    <Style x:Key="AppHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="20,14" />
    </Style>

    <Style x:Key="SidebarBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="StatusBarBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="20,7" />
    </Style>

    <!-- 页面容器：统一留白 -->
    <Style x:Key="PageRoot" TargetType="Grid">
        <Setter Property="Margin" Value="20" />
    </Style>

    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- ═══════════════ 组合：动作行 / 字段行 / 指标 ═══════════════ -->
    <Style x:Key="ToolbarRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="FieldRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- 指标块：上面一个数字，下面一行标签 -->
    <Style x:Key="MetricBlock" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>

    <!-- 键值对：左标签定宽右值 -->
    <Style x:Key="KvLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelTextStyle}">
        <Setter Property="Width" Value="72" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,1,12,0" />
    </Style>

    <Style x:Key="KvValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="KvValueMono" TargetType="TextBlock" BasedOn="{StaticResource KvValue}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ═══════════════ 状态文字（语义色例外） ═══════════════ -->
    <Style x:Key="TextSuccessStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TextDangerStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ═══════════════ 空状态 ═══════════════ -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- ═══════════════ 横幅（危险/警告/信息，唯一允许的彩色块） ═══════════════ -->
    <Style x:Key="DangerBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="WarningBanner" TargetType="Border" BasedOn="{StaticResource DangerBanner}">
        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
    </Style>

    <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource DangerBanner}">
        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
    </Style>

    <!-- ═══════════════ 导航图标（颜色跟随所在导航项的前景色） ═══════════════ -->
    <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- 小号行内图标（按钮/标题前缀） -->
    <Style x:Key="InlineIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextDimBrush}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

</ResourceDictionary>
