<!--
    Tokens.xaml —— 设计令牌（唯一改色的地方）
    ══════════════════════════════════════════════════════════════════════════
    风格：极简底 + 半调波普「只在交互处发声」
      · 背景极简：窗口/顶栏/侧栏/状态栏/卡片标题区全部白纸 + 黑线，没有色块。
        结构只靠 1px 黑线（卡片 2px），一眼扫过去是安静的。
      · 交互才丰富：明黄 #FFD400 + 半调网点只出现在能点、能选、有状态的地方——
        主按钮、次按钮悬停、选中项（导航/列表/页签/复选）、输入聚焦、徽标、工具提示。
      · 网点很克制：6px 一格、12% 黑，远看是"黄底有印刷颗粒"，近看才是点。
        不要网点：把 Controls/AppStyles 里的 AccentHalftoneBrush 换成 AccentBrush（全局替换）。
      · 文字黑；白字只出现在深色块上（黑/红/蓝底）。
      · 语义色保留高饱和，并一律配 2px 黑框。

    规则：控件样式只引用这里的令牌，不直接写十六进制色值；换主题只改本文件。
    ══════════════════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════ 字体 ═══════════════ -->
    <!-- 中文优先用雅黑：Segoe UI 的中文回落到宋体，字形会跳 -->
    <FontFamily x:Key="UiFontFamily">Microsoft YaHei UI, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <!-- ═══════════════ 表面 ═══════════════ -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FBFBF9" />   <!-- 窗口底：几乎纯白的纸，卡片再白一档 -->
    <SolidColorBrush x:Key="CardBrush"       Color="#FFFFFF" />   <!-- 卡片底 -->
    <SolidColorBrush x:Key="SubtleBrush"     Color="#F6F6F2" />   <!-- 表头/底栏的中性浅底 -->
    <SolidColorBrush x:Key="MutedBrush"      Color="#F1F1EC" />   <!-- 凹陷：画布/只读 -->
    <SolidColorBrush x:Key="HoverBrush"      Color="#FFF6CC" />   <!-- 通用悬停：淡黄 -->
    <SolidColorBrush x:Key="ScrimBrush"      Color="#66000000" /> <!-- 遮罩 -->

    <!-- ═══════════════ 墨（黑框 + 黑字） ═══════════════ -->
    <SolidColorBrush x:Key="InkBrush"       Color="#0B0B0B" />    <!-- 描边 / 文字 / 填充 -->
    <SolidColorBrush x:Key="InkHoverBrush"  Color="#2A2A2A" />
    <SolidColorBrush x:Key="InkSoftBrush"   Color="#F6F5F0" />    <!-- 浅灰底（少数地方仍要中性底） -->

    <!-- ═══════════════ 主色槽位（Accent）══════════════════════════════════
         这几个键是"可换色"的：控件样式统一用 {DynamicResource Accent*} 引用，
         运行时由 Services/ThemeService 整组替换（调色卡就是改这 5 个键）。
         默认 = 波普明黄。注意必须用 DynamicResource —— StaticResource 会把
         加载时那一个刷子实例焊死，换色不生效。 -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#FFD400" /> <!-- 主色：主按钮/选中/强调 -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFC400" /> <!-- 悬停 -->
    <SolidColorBrush x:Key="AccentDeepBrush"  Color="#E8BE00" /> <!-- 按下/描边 -->
    <SolidColorBrush x:Key="AccentSoftBrush"  Color="#FFF7C2" /> <!-- 淡底：悬停/聚焦 -->
    <SolidColorBrush x:Key="AccentTintBrush"  Color="#FFFAE1" /> <!-- 更淡：对话里"我"的气泡 -->
    <!-- 骑在主色块上的文字色（亮底黑字/暗底白字，运行时按亮度重算） -->
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0B0B0B" />

    <!-- ═══════════════ 线 ═══════════════ -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#0B0B0B" /> <!-- 硬框 2px -->
    <SolidColorBrush x:Key="BorderBrush"       Color="#0B0B0B" /> <!-- 控件描边 -->
    <SolidColorBrush x:Key="CardBorderBrush"   Color="#0B0B0B" /> <!-- 卡片轮廓 -->
    <SolidColorBrush x:Key="DividerBrush"      Color="#E6E6DE" /> <!-- 内部发丝线：列表行、卡片内分隔 -->
    <SolidColorBrush x:Key="InnerDividerBrush" Color="#E6E6DE" /> <!-- 同上（旧键名） -->
    <SolidColorBrush x:Key="DisabledBrush"     Color="#EDEAE0" />

    <!-- ═══════════════ 文字 ═══════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#0B0B0B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextDimBrush"       Color="#6B6B6B" />
    <SolidColorBrush x:Key="TextOnInkBrush"     Color="#FFFFFF" /> <!-- 黑/红/蓝底上的字 -->
    <!-- 文本选中色：由样式直接引用 AccentSoftBrush（见 Controls.xaml） -->

    <!-- ═══════════════ 语义色（高饱和 + 黑框） ═══════════════ -->
    <SolidColorBrush x:Key="InfoBrush"         Color="#0057FF" />
    <SolidColorBrush x:Key="InfoHoverBrush"    Color="#0046CC" />
    <SolidColorBrush x:Key="InfoSoftBrush"     Color="#E6EEFF" />
    <SolidColorBrush x:Key="SuccessBrush"      Color="#00A651" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#008741" />
    <SolidColorBrush x:Key="SuccessSoftBrush"  Color="#DFF7E6" />
    <SolidColorBrush x:Key="WarningBrush"      Color="#FF8A00" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#E07800" />
    <SolidColorBrush x:Key="WarningSoftBrush"  Color="#FFF0D6" />
    <SolidColorBrush x:Key="DangerBrush"       Color="#E4002B" />
    <SolidColorBrush x:Key="DangerHoverBrush"  Color="#C00024" />
    <SolidColorBrush x:Key="DangerSoftBrush"   Color="#FFE3E8" />

    <!-- ═══════════════ 自锁按键（抬起=未生效 / 按下=已生效） ═══════════════
         "按下"的底色直接引用主色槽位（见 Controls.xaml 的 LatchButtonStyle）。 -->
    <SolidColorBrush x:Key="LatchPressedBorderBrush" Color="#0B0B0B" />

    <!-- ═══════════════ 圆角令牌（全部归零 = 直角，波普不要圆角） ═══════════════ -->
    <CornerRadius x:Key="RadiusSm">0</CornerRadius>
    <CornerRadius x:Key="RadiusMd">0</CornerRadius>
    <CornerRadius x:Key="RadiusLg">0</CornerRadius>
    <CornerRadius x:Key="RadiusPill">0</CornerRadius>

    <!-- ═══════════════ 半调网点（只给交互元素用） ═══════════════
         6px 一格：明黄底 + 12% 黑的圆点。远看是"黄底带印刷颗粒"，近看才是点。
         用法：交互填充（主按钮/选中项/徽标/箭头块/页标题块）用它代替纯黄；
         背景与卡片一律不用——这就是"极简底 + 半调交互"的分界线。 -->
    <!-- 默认（波普黄）的网点；运行时 ThemeService 会按当前主色重建同名键 -->
    <DrawingBrush x:Key="AccentHalftoneBrush" TileMode="Tile"
                  Viewport="0,0,6,6" ViewportUnits="Absolute"
                  Viewbox="0,0,6,6" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFD400">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,6,6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#1F0B0B0B">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="3,3" RadiusX="1.55" RadiusY="1.55" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- ═══════════════ 排版（比上一版更粗、更响） ═══════════════ -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 页面标题 -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- 页面副标题 -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 卡片标题 -->
    <Style x:Key="CardHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 区块标题（旧键名，保留） -->
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource CardHeader}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CardHeader}" />

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 说明 / 次要文字 -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 表单标签 -->
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 等宽：日志 / 指标 / 图像信息 -->
    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- 数字指标 -->
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MetricValueSmall" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- 警示提示文字 -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WarningHoverBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
