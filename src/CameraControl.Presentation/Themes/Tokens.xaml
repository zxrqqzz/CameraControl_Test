<!--
    Tokens.xaml —— 设计令牌（唯一改色的地方）
    ══════════════════════════════════════════════════════════════════════════
    风格：波普 / Pop
      · 硬朗黑框：卡片、按钮、输入框一律 2px 纯黑描边，直角；卡片带无模糊的
        4px 黑投影（像贴纸）。这是全站最重的一条规则。
      · 波普明黄 PopYellow #FFD400 是唯一的品牌色：主按钮、选中态、顶栏、状态栏、
        卡片标题条。它代替了上一版的黑白灰——界面必须有颜色块，不能寡淡。
      · 只做纯色块，不铺网点/纹理：细密点阵在正文尺寸下会变成噪点，
        印刷感靠「黑框 + 硬投影 + 大色块」就成立。
      · 文字：黑；白字只出现在深色块上（黑/红/蓝底）。
      · 语义色保留高饱和（红=报警、绿=运行、橙=警告、蓝=信息），并一律配 2px 黑框。

    规则：控件样式只引用这里的令牌，不直接写十六进制色值；换主题只改本文件。
    ══════════════════════════════════════════════════════════════════════════
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════ 字体 ═══════════════ -->
    <!-- 中文优先用雅黑：Segoe UI 的中文回落到宋体，字形会跳 -->
    <FontFamily x:Key="UiFontFamily">Microsoft YaHei UI, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <!-- ═══════════════ 表面 ═══════════════ -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFBF0" />   <!-- 窗口底：暖白纸，卡片才是纯白 -->
    <SolidColorBrush x:Key="CardBrush"       Color="#FFFFFF" />   <!-- 卡片底 -->
    <SolidColorBrush x:Key="SubtleBrush"     Color="#FFF6DA" />   <!-- 暖黄白：表头/底栏 -->
    <SolidColorBrush x:Key="MutedBrush"      Color="#F0EBD9" />   <!-- 凹陷：画布/只读 -->
    <SolidColorBrush x:Key="HoverBrush"      Color="#FFF0B0" />   <!-- 通用悬停：淡黄 -->
    <SolidColorBrush x:Key="ScrimBrush"      Color="#66000000" /> <!-- 遮罩 -->

    <!-- ═══════════════ 墨（黑框 + 黑字） ═══════════════ -->
    <SolidColorBrush x:Key="InkBrush"       Color="#0B0B0B" />    <!-- 描边 / 文字 / 填充 -->
    <SolidColorBrush x:Key="InkHoverBrush"  Color="#2A2A2A" />
    <SolidColorBrush x:Key="InkSoftBrush"   Color="#F6F5F0" />    <!-- 浅灰底（少数地方仍要中性底） -->

    <!-- ═══════════════ 波普明黄 ═══════════════ -->
    <SolidColorBrush x:Key="PopYellowBrush"      Color="#FFD400" /> <!-- 主色 -->
    <SolidColorBrush x:Key="PopYellowHoverBrush" Color="#FFC400" /> <!-- 悬停 -->
    <SolidColorBrush x:Key="PopYellowDeepBrush"  Color="#E8BE00" /> <!-- 按下 -->
    <SolidColorBrush x:Key="PopYellowSoftBrush"  Color="#FFF7C2" /> <!-- 淡黄底：悬停/选中行 -->

    <!-- ═══════════════ 线 ═══════════════ -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#0B0B0B" /> <!-- 硬框 2px -->
    <SolidColorBrush x:Key="BorderBrush"       Color="#0B0B0B" /> <!-- 控件描边 -->
    <SolidColorBrush x:Key="CardBorderBrush"   Color="#0B0B0B" /> <!-- 卡片轮廓 -->
    <SolidColorBrush x:Key="DividerBrush"      Color="#0B0B0B" /> <!-- 结构线（1px 黑） -->
    <SolidColorBrush x:Key="InnerDividerBrush" Color="#E6E2D4" /> <!-- 卡片内部发丝线 -->
    <SolidColorBrush x:Key="DisabledBrush"     Color="#EDEAE0" />

    <!-- ═══════════════ 文字 ═══════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#0B0B0B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextDimBrush"       Color="#6B6B6B" />
    <SolidColorBrush x:Key="TextOnInkBrush"     Color="#FFFFFF" /> <!-- 黑/红/蓝底上的字 -->
    <SolidColorBrush x:Key="SelectionBrush"     Color="#FFD400" /> <!-- 文本选中：明黄 -->

    <!-- ═══════════════ 语义色（高饱和 + 黑框） ═══════════════ -->
    <SolidColorBrush x:Key="InfoBrush"         Color="#0057FF" />
    <SolidColorBrush x:Key="InfoHoverBrush"    Color="#0046CC" />
    <SolidColorBrush x:Key="InfoSoftBrush"     Color="#E6EEFF" />
    <SolidColorBrush x:Key="SuccessBrush"      Color="#00A651" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#008741" />
    <SolidColorBrush x:Key="SuccessSoftBrush"  Color="#DFF7E6" />
    <SolidColorBrush x:Key="WarningBrush"      Color="#FF8A00" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#E07800" />
    <SolidColorBrush x:Key="WarningSoftBrush"  Color="#FFF0D6" />
    <SolidColorBrush x:Key="DangerBrush"       Color="#E4002B" />
    <SolidColorBrush x:Key="DangerHoverBrush"  Color="#C00024" />
    <SolidColorBrush x:Key="DangerSoftBrush"   Color="#FFE3E8" />

    <!-- ═══════════════ 自锁按键（抬起=未生效 / 按下=已生效） ═══════════════ -->
    <SolidColorBrush x:Key="LatchPressedBrush"       Color="#FFD400" />
    <SolidColorBrush x:Key="LatchPressedBorderBrush" Color="#0B0B0B" />

    <!-- ═══════════════ 圆角令牌（全部归零 = 直角，波普不要圆角） ═══════════════ -->
    <CornerRadius x:Key="RadiusSm">0</CornerRadius>
    <CornerRadius x:Key="RadiusMd">0</CornerRadius>
    <CornerRadius x:Key="RadiusLg">0</CornerRadius>
    <CornerRadius x:Key="RadiusPill">0</CornerRadius>

    <!-- 说明：这里曾放过三支半调网点（Ben-Day dots）DrawingBrush，已按需求去掉。
         界面只保留纯色块 + 黑框 + 硬投影；要恢复网点只需在本处重新定义
         HalftoneYellowBrush 等键，再无别处需要改。 -->
    <!-- 说明：这里曾放过 DropShadowEffect 硬投影（4~10px 无模糊偏移）。
         实测在 2px 黑框旁边读不出"贴纸影子"，只是把右下边框加粗、显得不齐，
         所以去掉——版面的重量交给黑框与色块。要恢复只需在本处重新定义
         PopShadow 并给卡片样式加 Effect setter。 -->
    <!-- ═══════════════ 排版（比上一版更粗、更响） ═══════════════ -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 页面标题 -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- 页面副标题 -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 卡片标题 -->
    <Style x:Key="CardHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 区块标题（旧键名，保留） -->
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource CardHeader}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CardHeader}" />

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 说明 / 次要文字 -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 表单标签 -->
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 等宽：日志 / 指标 / 图像信息 -->
    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- 数字指标 -->
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MetricValueSmall" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- 警示提示文字 -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WarningHoverBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
