<Application x:Class="CameraControl.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ═══════════ 主题：改颜色只动 Themes/Tokens.xaml ═══════════
                 Converters = 转换器实例（页面与控件模板共用）
                 Tokens     = 颜色/排版令牌
                 Controls   = 单控件风格（按钮/输入/列表…）
                 AppStyles  = 页面骨架（顶栏/侧栏/状态栏/空状态）
                 都用相对路径引用：删掉 Themes 会在启动时炸掉——这是刻意的，
                 "样式没加载"必须立刻暴露，不能悄悄退回系统默认皮肤。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Converters.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
