<Window x:Class="CameraControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CameraControl"
        
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="2">
            <Button Content="单次采集" FontSize="16" 
                    Margin="5"
                    Height="40" Width="100"
                    Command="{Binding SingleCaptureCommand}"/>
            <Button Content="连续采集" FontSize="16"
                    Margin="5" Height="40" Width="100"
                    Command="{Binding ContinuousCaptureCommand}"/>
        </StackPanel>

        <!-- 图像显示区域 -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <Image Source="{Binding CurrentImage}" Stretch="Uniform" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>


        <!-- Row 2 – 日志区域 -->
        <Grid Grid.Row="2" Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="日志输出:" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                <Button Content="清空日志" Command="{Binding LogVM.ClearLogCommand}" 
                        Width="80" Height="28" Margin="10,2,10,2"/>
            </StackPanel>

            <ListBox Grid.Row="2" 
                     ItemsSource="{Binding LogVM.Logs}" 
                     Height="100" 
                     Margin="5"
                     Background="White" 
                     Foreground="Black"
                     FontFamily="Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
        </Grid>
        

    </Grid>
</Window>
