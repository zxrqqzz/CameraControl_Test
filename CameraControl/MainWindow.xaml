<Window x:Class="CameraControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CameraControl"
        xmlns:views="clr-namespace:CameraControl.Views"
        
        mc:Ignorable="d"
        Title="CameraControl" Height="620" Width="960">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 侧边栏导航项样式 -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" Padding="12,9" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DarkSurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部菜单栏 -->
        <Menu Grid.Row="0" Background="{StaticResource DarkSurfaceBrush}" Foreground="White" Padding="0">
            <MenuItem Header="通讯管理" Click="OnCommunicationClick"/>
            <MenuItem Header="全局触发" Click="OnGlobalTriggerClick"/>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0" Background="{StaticResource DarkSurfaceBrush}">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="导航" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               FontSize="15" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,20"/>
                    <RadioButton Content="主界面" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding IsMainView, Mode=OneWay}" Command="{Binding ShowMainViewCommand}"/>
                    <RadioButton Content="标定界面" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding IsCalibrationView, Mode=OneWay}" Command="{Binding ShowCalibrationViewCommand}"/>
                    <RadioButton Content="标定工具" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding IsCalibrationToolsView, Mode=OneWay}" Command="{Binding ShowCalibrationToolsViewCommand}"/>
                    <RadioButton Content="用户坐标直接读取" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding IsUserCoordView, Mode=OneWay}" Command="{Binding ShowUserCoordViewCommand}"/>
                </StackPanel>
            </Border>

            <!-- 主界面 -->
            <Grid Grid.Column="1" 
                  Background="{StaticResource BackgroundBrush}"
                  Visibility="{Binding IsMainView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="12,12,12,8">
                    <TextBlock Text="相机:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="连接" Style="{StaticResource PrimaryButton}"
                            Height="36" Width="80"
                            Command="{Binding ConnectCameraCommand}"/>
                    <Button Content="断开" Style="{StaticResource SecondaryButton}"
                            Height="36" Width="80"
                            Margin="8,0,0,0"
                            Command="{Binding DisconnectCameraCommand}"/>
                    <TextBlock Text="{Binding CameraStatusText}" VerticalAlignment="Center"
                               FontSize="13" Margin="16,0,16,0" 
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="单次采集" Style="{StaticResource PrimaryButton}"
                            Height="36" Width="100"
                            Margin="0,0,8,0"
                            Command="{Binding SingleCaptureCommand}"/>
                    <Button Content="连续采集" Style="{StaticResource SecondaryButton}"
                            Height="36" Width="100"
                            Command="{Binding ContinuousCaptureCommand}"/>
                </StackPanel>

                <!-- 图像显示区域 -->
                <Grid Grid.Row="1" Margin="12">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Image Source="{Binding CurrentImage}" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 日志区域 -->
                <Grid Grid.Row="2" Margin="12,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="日志输出:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="清空日志" Style="{StaticResource SecondaryButton}"
                                Command="{Binding LogVM.ClearLogCommand}"
                                Width="80" Height="28" Margin="12,0,0,0"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding LogVM.Logs}"
                             Height="100"
                             Style="{StaticResource ListBoxStyle}"
                             FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- 标定界面 -->
            <views:CalibrationView Grid.Column="1" DataContext="{Binding CalibrationVM}"
                                   Visibility="{Binding DataContext.IsCalibrationView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

            <!-- 标定工具界面 -->
            <views:CalibrationToolsView Grid.Column="1" DataContext="{Binding CalibrationVM}"
                                        Visibility="{Binding DataContext.IsCalibrationToolsView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

            <!-- 用户坐标直接读取界面 -->
            <views:UserCoordinateView Grid.Column="1" DataContext="{Binding UserCoordVM}"
                                      Visibility="{Binding DataContext.IsUserCoordView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Window>