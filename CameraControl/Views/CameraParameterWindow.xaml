<Window x:Class="CameraControl.Views.CameraParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:CameraControl.Models"
        mc:Ignorable="d"
        Title="参数设置" Height="600" Width="840"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontSize="13"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧: 分类侧边栏 -->
        <Border Grid.Column="0" Background="{StaticResource DarkSurfaceBrush}" CornerRadius="6" Padding="8">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="参数分类" Foreground="White" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Name}"
                                         GroupName="ParamCat"
                                         Style="{StaticResource WindowNavItemStyle}"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding SelectCommand}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 右侧: 当前分类的参数列表 -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部: 标题 + 刷新 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding SelectedCategory}" FontWeight="SemiBold" FontSize="18"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button Content="刷新参数" HorizontalAlignment="Right" Height="32" Width="100"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- 状态栏 -->
            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="0,0,0,10"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>

            <!-- 参数列表 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CurrentParameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource MutedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="12" Margin="0,0,0,8" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 参数名 -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Key}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- 参数值控件 -->
                                    <Grid Grid.Column="1" Margin="12,0">
                                        <!-- Float / Int -->
                                        <Grid Visibility="{Binding NumericVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    TickFrequency="{Binding Step}"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding NumericValue, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBox Text="{Binding NumericValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="90" Height="26"
                                                         Style="{StaticResource InputBox}"
                                                         IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"/>
                                                <TextBlock Text="{Binding Unit}" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Enum -->
                                        <ComboBox Visibility="{Binding EnumVisibility}"
                                                  ItemsSource="{Binding EnumItems}"
                                                  SelectedValuePath="Item2"
                                                  DisplayMemberPath="Item1"
                                                  SelectedValue="{Binding SelectedEnum, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                                                  Height="28" Style="{StaticResource ComboStyle}"/>

                                        <!-- Bool -->
                                        <CheckBox Visibility="{Binding BoolVisibility}"
                                                  IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                                                  VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <!-- String -->
                                        <TextBox Visibility="{Binding StringVisibility}"
                                                 Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="28" Style="{StaticResource InputBox}"
                                                 IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"/>

                                        <!-- Command (执行按钮并禁用) -->
                                        <TextBlock Visibility="{Binding CommandVisibility}"
                                                   Text="(执行命令)" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 应用按钮 -->
                                    <Button Grid.Column="2" Content="应用" Width="70" Height="28"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
