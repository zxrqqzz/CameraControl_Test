<UserControl x:Class="CameraControl.Views.UserCoordinateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接区 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="机器人IP:" VerticalAlignment="Center" FontSize="14"/>
            <TextBox Text="{Binding RobotIp, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" Height="26" Margin="4,0,6,0"
                     VerticalContentAlignment="Center"/>
            <Button Content="连接机器人" Command="{Binding ConnectCommand}"
                    Width="90" Height="30" Margin="0,0,10,0"/>
            <TextBlock Text="用户坐标系(UF):" VerticalAlignment="Center" FontSize="14"/>
            <TextBox Text="{Binding UserFrameText, UpdateSourceTrigger=PropertyChanged}"
                     Width="50" Height="26" Margin="4,0,4,0"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="(示教器中建立好的坐标系编号, 1~63)" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- 当前二维坐标(直接读取结果) -->
        <Border Grid.Row="1" BorderBrush="DodgerBlue" BorderThickness="2" Padding="10,6" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="当前位置(用户坐标系, 无需手动标定): X/Y 二维坐标 + Rz 旋转角(绕用户Z轴)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="X2: " FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentX2Text}" FontSize="26" FontWeight="Bold" Foreground="#FF007ACC" Width="130" VerticalAlignment="Center"/>
                    <TextBlock Text="Y2: " FontSize="26" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentY2Text}" FontSize="26" FontWeight="Bold" Foreground="#FF007ACC" Width="130" VerticalAlignment="Center"/>
                    <TextBlock Text="Rz: " FontSize="26" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRzText}" FontSize="26" FontWeight="Bold" Foreground="#FF007ACC" Width="110" VerticalAlignment="Center"/>
                    <TextBlock Text="°" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 操作区 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <WrapPanel>
                <Button Content="读取当前位置(用户坐标)" Command="{Binding ReadUserFrameCommand}"
                        Width="180" Height="34" FontSize="13" Margin="0,0,8,4"/>
                <ToggleButton Content="记录坐标(含旋转角)" IsChecked="{Binding IsRecording2D}"
                              Width="140" Height="34" FontSize="13" Margin="0,0,8,4">
                    <ToggleButton.ToolTip>
                        <TextBlock Text="按下: 开始记录之后读取的标定点坐标(X,Y,Rz)&#x0a;再次点击: 停止记录并保存为txt文件后清空"/>
                    </ToggleButton.ToolTip>
                </ToggleButton>
                <Button Content="清空记录" Command="{Binding ClearCommand}"
                        Width="90" Height="34" FontSize="13" Margin="0,0,8,4"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="二维坐标+旋转角→用户直角坐标:" FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="X2:" VerticalAlignment="Center" FontSize="13"/>
                <TextBox Text="{Binding InputX2, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Height="26" Margin="2,0,6,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Y2:" VerticalAlignment="Center" FontSize="13"/>
                <TextBox Text="{Binding InputY2, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Height="26" Margin="2,0,6,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Rz:" VerticalAlignment="Center" FontSize="13"/>
                <TextBox Text="{Binding InputRz, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Height="26" Margin="2,0,8,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="°" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                <Button Content="转换为用户直角坐标" Command="{Binding Convert2DToPendantCommand}"
                        Width="150" Height="30" FontSize="13"/>
            </StackPanel>

            <!-- 标定点记录列表 -->
            <TextBlock Text="标定点记录(X,Y,Rz):" FontWeight="Bold" FontSize="13" Margin="0,6,0,2"/>
            <ListBox ItemsSource="{Binding User2DRecords}" Height="70"
                     Margin="0,0,0,4" FontFamily="Consolas" FontSize="12" Background="White">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- 输出区 -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
            <TextBox Text="{Binding OutputText, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="13" Padding="6"
                     Background="White" Foreground="Black"/>
        </Border>

        <!-- 示教器使用说明 -->
        <Border Grid.Row="4" BorderBrush="#FFE0A030" BorderThickness="1" Margin="0,8,0,0" Padding="8"
                Background="#FFFDF6E3">
            <Border.ToolTip>
                <TextBlock Text="示教器建立用户坐标系(UF)参考步骤(以安川DX200/YRC1000为例)"/>
            </Border.ToolTip>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF6B5200">
              <Run Text="示教器用户坐标系建立步骤(安川): 1. 示教器进入 [机器人]→[用户坐标系]→[UF设] 选择未使用编号(如UF1)。 2. 选择坐标设定方式(推荐3点法): 示教[原点O]、[X方向点X]、[Y方向点Y]。 3. 移动机械臂到工装/物料板原点，按[修改+回车]保存。 4. 再移动机械臂到X轴正方向某点(尽量远，距离越大精度越高)，保存。 5. 再移动机械臂到Y轴正方向某点，保存。 6. 返回后选定UF1为当前坐标系，用[世界/用户]切换显示，验证移动时X/Y方向正确、Z为法线方向。 完成后在本页输入该UF编号，点击&quot;读取当前位置(用户坐标)&quot;即可直接获得二维坐标。 Rz 为绕用户Z轴(垂直于用户坐标平面的法线轴)的旋转角，用于视觉标定旋转轴；当工具Z轴与用户Z轴平行(Rx、Ry≈0)时，Rz 即物体在平面内的转角。"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
