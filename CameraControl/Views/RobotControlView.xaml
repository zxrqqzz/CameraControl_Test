<UserControl x:Class="CameraControl.Views.RobotControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左列: 连接与坐标系选择 ============ -->
        <DockPanel Grid.Column="0">
            <!-- 连接区 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="机器人IP:" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding RobotIp, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         Width="130" Height="28" Margin="8,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Button Content="连接" Command="{Binding ConnectCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="70" Height="32"/>
            </StackPanel>

            <!-- 坐标系选择 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="坐标系设置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="坐标系类型:" VerticalAlignment="Center" FontSize="13" Width="80"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding FrameTypes}" 
                                  SelectedItem="{Binding SelectedFrameType}"
                                  Width="180" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="坐标系编号:" VerticalAlignment="Center" FontSize="13" Width="80"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding FrameNumbers}" 
                                  SelectedItem="{Binding SelectedFrameNumber}"
                                  Width="100" Height="28" VerticalContentAlignment="Center"/>
                        <Button Content="刷新" Command="{Binding RefreshFrameListCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="60" Height="28" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 读取按钮 -->
            <Button DockPanel.Dock="Top" Content="读取当前位置" Command="{Binding ReadPositionCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="120" Height="36" Margin="0,0,0,12"/>

            <!-- 当前位置显示 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" 
                    Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="当前位置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentX}" 
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Y:" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding CurrentY}" 
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Z:" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentZ}" 
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Rx:" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding CurrentRx}" 
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ry:" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentRy}" 
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Grid.Column="3" Text="Rz:" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding CurrentRz}" 
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 命令历史 -->
            <TextBlock DockPanel.Dock="Top" Text="命令历史:" FontWeight="SemiBold" FontSize="13" 
                       Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <ListBox ItemsSource="{Binding CommandHistory}" Height="100"
                     Style="{StaticResource ListBoxStyle}" FontSize="11">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 分隔条 -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

        <!-- ============ 右列: 坐标输入与运动控制 ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 坐标输入区 -->
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="目标坐标输入" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    
                    <!-- 位置输入 -->
                    <TextBlock Text="位置 (mm)" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding InputX, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Height="30"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="4" Text="{Binding InputY, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Height="30"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="Z:" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="7" Text="{Binding InputZ, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Height="30"
                                 VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- 姿态输入 -->
                    <TextBlock Text="姿态 (°)" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rx:" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding InputRx, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Height="30"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Ry:" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="4" Text="{Binding InputRy, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Height="30"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="Rz:" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="7" Text="{Binding InputRz, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Height="30"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 运动控制区 -->
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="运动控制" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="运动类型:" VerticalAlignment="Center" FontSize="13" Width="70"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding MotionTypes}" 
                                  SelectedItem="{Binding SelectedMotionType}"
                                  Width="140" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                        
                        <TextBlock Text="速度(%):" VerticalAlignment="Center" FontSize="13" Width="60"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Width="50" Height="28"
                                 VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="执行移动" Command="{Binding MoveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100" Height="36" Margin="0,0,10,0"/>
                        <Button Content="回原点" Command="{Binding MoveToOriginCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="80" Height="36" Margin="0,0,10,0"/>
                        <Button Content="停止" Command="{Binding StopCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="80" Height="36"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 输出区 -->
            <Border Grid.Row="2" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="输出信息:" FontWeight="SemiBold" FontSize="13" 
                               Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding OutputText, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>