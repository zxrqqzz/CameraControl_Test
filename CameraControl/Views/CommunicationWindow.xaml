<Window x:Class="CameraControl.Views.CommunicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="通讯管理" Height="500" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontSize="13"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧: 添加设备 -->
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="添加设备" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="设备名称:" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         Height="28" Margin="0,4,0,14"/>
                <TextBlock Text="设备类型:" Foreground="{StaticResource TextSecondaryBrush}"/>
                <RadioButton Content="TCP客户端" IsChecked="{Binding IsTcpClient}" Margin="0,6,0,4"/>
                <RadioButton Content="TCP服务端" IsChecked="{Binding IsTcpServer}" Margin="0,4,0,14"/>
                <TextBlock Text="IP地址:" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         Height="28" Margin="0,4,0,14"/>
                <TextBlock Text="端口号:" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding NewPortText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         Height="28" Margin="0,4,0,18"/>
                <Button Content="添加设备" Command="{Binding AddDeviceCommand}" Height="36" FontSize="14"
                        Style="{StaticResource PrimaryButton}"/>
                <TextBlock Text="提示: TCP服务端监听本机端口; 客户端连接指定的IP端口。&#x0a;接收数据后全局触发按配置回传到该设备。"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" 
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- 右侧: 设备列表 -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="设备列表" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding Devices}"
                     Style="{StaticResource ListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource MutedBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="连接"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Width="70" Height="30" Margin="0,0,8,0"
                                            Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="断开"
                                            Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Width="70" Height="30" Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButton}"/>
                                    <Button Content="删除"
                                            Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Width="70" Height="30"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>