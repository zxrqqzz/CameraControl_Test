<Window x:Class="CameraControl.Views.CommunicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="通讯管理" Height="500" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontSize="13">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧: 添加设备 -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="添加设备" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                <TextBlock Text="设备名称:"/>
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         Height="26" Margin="0,2,0,10" VerticalContentAlignment="Center"/>
                <TextBlock Text="设备类型:"/>
                <RadioButton Content="TCP客户端" IsChecked="{Binding IsTcpClient}" Margin="0,4,0,2"/>
                <RadioButton Content="TCP服务端" IsChecked="{Binding IsTcpServer}" Margin="0,2,0,10"/>
                <TextBlock Text="IP地址:"/>
                <TextBox Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged}"
                         Height="26" Margin="0,2,0,10" VerticalContentAlignment="Center"/>
                <TextBlock Text="端口号:"/>
                <TextBox Text="{Binding NewPortText, UpdateSourceTrigger=PropertyChanged}"
                         Height="26" Margin="0,2,0,14" VerticalContentAlignment="Center"/>
                <Button Content="添加设备" Command="{Binding AddDeviceCommand}" Height="34" FontSize="14"/>
                <TextBlock Text="提示: TCP服务端监听本机端口; 客户端连接指定的IP端口。&#x0a;接收数据后全局触发按配置回传到该设备。"
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- 右侧: 设备列表 -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="设备列表" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" Background="White">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,0,0,6" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="连接"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Width="64" Height="28" Margin="0,0,6,0"/>
                                    <Button Content="断开"
                                            Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Width="64" Height="28" Margin="0,0,6,0"/>
                                    <Button Content="删除"
                                            Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Width="64" Height="28"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>