<Window x:Class="CameraControl.Views.DeviceScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="扫描设备" Height="620" Width="940"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontSize="13"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 扫描范围 ══════════ -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="14" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="扫描范围" FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="（勾选项会记住）" FontSize="11" Margin="6,2,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <CheckBox Content="海康 SDK（GigE / USB3 Vision / 采集卡）"
                              IsChecked="{Binding Options.EnableHikSdk}"
                              IsEnabled="{Binding CanStartScan}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,20,8" VerticalContentAlignment="Center"/>

                    <CheckBox Content="本机摄像头（UVC，含笔记本自带）"
                              IsChecked="{Binding Options.EnableUvc}"
                              IsEnabled="{Binding CanStartScan}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,20,8" VerticalContentAlignment="Center"/>

                    <CheckBox Content="局域网被动检测（读 ARP 表，零流量）"
                              IsChecked="{Binding Options.EnableLanPassive}"
                              IsEnabled="{Binding CanStartScan}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,20,8" VerticalContentAlignment="Center"/>

                    <CheckBox Content="ONVIF 主动发现（会发组播报文）"
                              IsChecked="{Binding Options.EnableLanOnvif}"
                              IsEnabled="{Binding CanStartScan}"
                              Foreground="#B45309"
                              Margin="0,0,0,8" VerticalContentAlignment="Center"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ══════════ 局域网安全说明 ══════════ -->
        <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                Padding="12,9" CornerRadius="4" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#92400E"
                       Text="局域网结果只用于识别：不会连接、不会登录、不会请求视频流或图像。默认仅读取本机 ARP 邻居表（不发送任何网络报文）；只有勾选「ONVIF 主动发现」才会发出一条标准发现组播，并只读取设备自己广播的厂商与型号。"/>
        </Border>

        <!-- ══════════ 操作栏 ══════════ -->
        <Grid Grid.Row="2" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="开始扫描" Width="96" Height="32"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartScanCommand}"
                    IsEnabled="{Binding CanStartScan}"/>

            <Button Grid.Column="1" Content="取消" Width="72" Height="32" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelScanCommand}"
                    IsEnabled="{Binding IsScanning}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                             Background="{StaticResource MutedBrush}"
                             Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Grid.Column="3" Text="{Binding SummaryText}" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>

        <!-- ══════════ 结果列表 ══════════
             注意: 这里刻意不用 ListView + GridView。
             WPF 的 GridViewColumnHeader 在应用模板时会调用 Cursor.LoadFromStream，
             进而在 %TEMP%\WPF\ 下创建临时文件；某些机器（临时目录被策略/杀软限制）
             会抛 UnauthorizedAccessException，导致窗口在 Show() 里直接崩掉。
             改用 ListBox + Grid 行模板（表头自绘），完全绕开这段代码。
             下方表头与行模板的列宽必须保持一致。 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 表头 -->
            <Border Grid.Row="0" Background="{StaticResource MutedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="名称" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="厂商" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="型号" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="4" Text="IP" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="5" Text="序列号" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="6" Text="来源" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="7" Text="状态" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
            </Border>

            <!-- 数据行 -->
            <ListBox Grid.Row="1" x:Name="ResultList"
                     ItemsSource="{Binding Candidates}"
                     Background="{StaticResource CardBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelect}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Vendor}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Model}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Ip}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding SerialNumber}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="6" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Column="7" Text="{Binding StatusText}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDetectedOnly}" Value="True">
                                                <Setter Property="Foreground" Value="#B45309"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空结果提示 -->
            <TextBlock Grid.Row="1"
                       Text="没有扫描到设备。检查一下：相机是否上电、网线是否插好、USB 是否连接；笔记本自带摄像头请勾选「本机摄像头」。"
                       TextWrapping="Wrap" MaxWidth="520"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ══════════ 底栏 ══════════ -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="全选" Width="70" Height="30"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectAllCommand}"/>
                <Button Content="全不选" Width="70" Height="30" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectNoneCommand}"/>
                <Button Content="只选未添加" Width="96" Height="30" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectNewOnlyCommand}"/>
                <TextBlock Text="{Binding SelectedCount, StringFormat='已选 {0} 个'}"
                           FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Width="80" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"/>
                <Button Content="添加所选" Width="96" Height="32"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddSelectedCommand}"
                        IsEnabled="{Binding CanAddSelected}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
