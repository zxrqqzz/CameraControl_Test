<UserControl x:Class="CameraControl.Views.CalibrationToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左列: 机器人实际坐标 ============ -->
        <DockPanel Grid.Column="0">
            <!-- 连接区 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="机器人IP:" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding RobotIp, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         Width="130" Height="28" Margin="8,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Button Content="连接机器人" Command="{Binding ConnectCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="100" Height="32"/>
            </StackPanel>

            <!-- 读取/保存按钮区 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="读取机器人位置" Command="{Binding ReadRobotCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="150" Height="34" Margin="0,0,10,0"/>
                <ToggleButton Content="记录读取坐标" IsChecked="{Binding IsRecordingRead}"
                              Style="{StaticResource ToggleButtonStyle}"
                              Width="130" Height="34">
                    <ToggleButton.ToolTip>
                        <TextBlock Text="按下: 开始记录之后读取的位置坐标&#x0a;再次点击: 停止记录并保存为txt文件后清空"/>
                    </ToggleButton.ToolTip>
                </ToggleButton>
            </StackPanel>

            <!-- 实际坐标显示 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                <TextBox Text="{Binding RobotOutputText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"
                         Height="90"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Background="{StaticResource CardBrush}" 
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0" Padding="8"/>
            </Border>

            <!-- 读取坐标记录 -->
            <TextBlock DockPanel.Dock="Top" Text="已读取的坐标(实际坐标):"
                       FontWeight="SemiBold" FontSize="13" Margin="0,4,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding ReadRecords}" Height="80"
                     Margin="0,0,0,10" FontFamily="Consolas" FontSize="12"
                     Style="{StaticResource ListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 转换坐标记录 -->
            <TextBlock DockPanel.Dock="Top" Text="转换后的坐标:"
                       FontWeight="SemiBold" FontSize="13" Margin="0,4,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding ConvertRecords}" Height="80"
                     Margin="0,0,0,10" FontFamily="Consolas" FontSize="12"
                     Style="{StaticResource ListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 二维坐标记录 -->
            <TextBlock DockPanel.Dock="Top" Text="二维坐标记录:"
                       FontWeight="SemiBold" FontSize="13" Margin="0,4,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Record2DList}" Height="80"
                     Margin="0,0,0,10" FontFamily="Consolas" FontSize="12"
                     Style="{StaticResource ListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="提示: 记录按钮按下后存储对应坐标，再次点击停止并保存为txt文件后清空。"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- 分隔条 -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

        <!-- ============ 右列: 转换工具 ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 转换区 -->
            <StackPanel Grid.Row="0">
                <WrapPanel>
                    <Button Content="读取当前位姿并转为2轴坐标"
                            Command="{Binding ConvertCurrentCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Width="220" Height="34"/>
                    <Button Content="50次精度测试" Command="{Binding PrecisionTestCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Width="130" Height="34" Margin="10,0,0,0"/>
                    <ToggleButton Content="记录二维坐标" IsChecked="{Binding IsRecording2D}"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  Width="130" Height="34" Margin="10,0,0,0">
                        <ToggleButton.ToolTip>
                            <TextBlock Text="按下: 开始记录之后转换的二维坐标&#x0a;再次点击: 停止记录并保存为txt文件后清空"/>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                </WrapPanel>
                <!-- 二维坐标 -> 6轴坐标(手动输入) -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="二维坐标→6轴(手动输入):" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="X2:" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding InputX2, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}"
                             Width="80" Height="28" Margin="4,0,10,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="Y2:" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding InputY2, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}"
                             Width="80" Height="28" Margin="4,0,10,0"
                             VerticalContentAlignment="Center"/>
                    <Button Content="转换为6轴坐标" Command="{Binding Convert2DTo6AxisCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Width="140" Height="32"/>
                    <ToggleButton Content="记录转换坐标" IsChecked="{Binding IsRecordingConvert}"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  Width="130" Height="32" Margin="10,0,0,0">
                        <ToggleButton.ToolTip>
                            <TextBlock Text="按下: 开始记录之后转换的坐标&#x0a;再次点击: 停止记录并保存为txt文件后清空"/>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                </StackPanel>
            </StackPanel>

            <!-- 输出区(可选取复制) -->
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,12,0,0">
                <TextBox Text="{Binding OutputText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13" Padding="8"
                         Background="{StaticResource CardBrush}" 
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>