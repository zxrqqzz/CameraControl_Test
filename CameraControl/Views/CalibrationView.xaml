<UserControl x:Class="CameraControl.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 第一步: 标定点采集 -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" Margin="0,0,0,12" Padding="12">
            <StackPanel>
                <TextBlock Text="第一步: 三点确定一个平面，将机器人移动到原点、X轴上一点、Y轴上一点并读取"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <UniformGrid Columns="3">
                    <Button Content="读取原点" Command="{Binding ReadPointCommand}" CommandParameter="1" Height="36" Margin="4"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button Content="读取X轴点" Command="{Binding ReadPointCommand}" CommandParameter="2" Height="36" Margin="4"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button Content="读取Y轴点" Command="{Binding ReadPointCommand}" CommandParameter="3" Height="36" Margin="4"
                            Style="{StaticResource PrimaryButton}"/>
                </UniformGrid>
                <ListBox ItemsSource="{Binding Points}" Height="120" Margin="0,12,0,0"
                         Style="{StaticResource ListBoxStyle}"
                         FontFamily="Consolas" FontSize="13">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                         Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 第二步: 计算标定 + 取值范围/精度设置 + 导出/导入 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="第二步: 建立二维直角坐标系(计算标定)"
                        Command="{Binding CalculateCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="260" Height="36" Margin="0,0,12,0"/>
                <!-- 取值范围/精度设置区 -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" 
                        BorderThickness="1" Margin="0,0,12,0"
                        Padding="10,6" VerticalAlignment="Center">
                    <Border.ToolTip>
                        <TextBlock Text="物料板为 48cm(480mm)，坐标按 mm 输出。&#x0a;取值范围: 板宽/板高定义了 X2、Y2 的合法区间 [0~上限]mm。&#x0a;精度: 坐标输出按该值取整(如 1=mm, 0.1=亚毫米)。"/>
                    </Border.ToolTip>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="板宽(mm):" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding BoardWidthText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}"
                                 Width="56" Height="28" Margin="6,0,12,0"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="板高(mm):" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding BoardHeightText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}"
                                 Width="56" Height="28" Margin="6,0,12,0"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="精度(mm):" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding PrecisionText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}"
                                 Width="56" Height="28" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Content="导出坐标系" Command="{Binding ExportCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="100" Height="32" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Content="导入坐标系" Command="{Binding ImportCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="100" Height="32" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Content="清空标定" Command="{Binding ClearCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="100" Height="32" VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>

        <!-- 输出区(可选取复制) -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" Margin="0,12,0,0">
            <TextBox Text="{Binding OutputText, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="13" Padding="8"
                     Background="{StaticResource CardBrush}" 
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderThickness="0"/>
        </Border>
    </Grid>
</UserControl>