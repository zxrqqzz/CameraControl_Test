<Application x:Class="CameraControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CameraControl"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- SaaS Minimalist Modern Design Tokens                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <!-- 深色区域 (侧边栏/顶栏) -->
            <SolidColorBrush x:Key="DarkSurfaceBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="DarkSurfaceHoverBrush" Color="#334155"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#475569"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#5A6D82"/>

            <!-- 浅色区域 (内容区) -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#F1F5F9"/>

            <!-- 文字 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

            <!-- 边框 -->
            <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 控件样式 (仅Setter，无ControlTemplate)                        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <!-- 按钮：统一石板灰蓝色 -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,7"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,7"/>
            </Style>

            <!-- 切换按钮：统一石板灰蓝色 -->
            <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,7"/>
            </Style>

            <!-- 输入框 -->
            <Style x:Key="InputBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>

            <!-- 下拉框 -->
            <Style x:Key="ComboStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="4,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- 列表框 -->
            <Style x:Key="ListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- 反向Bool转Visibility -->
            <local:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>

            <!-- Bool转Visibility (全局可用) -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 字符串相等转换器 -->
            <local:StringEqualsConverter x:Key="StringEqualsConverter"/>

            <!-- 布尔取反转换器 -->
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <!-- 窗口内侧边栏导航项样式 -->
            <Style x:Key="WindowNavItemStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="4,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" Padding="10,8" CornerRadius="4">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource DarkSurfaceHoverBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>